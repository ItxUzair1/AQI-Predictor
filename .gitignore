htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.swn
.pytest_cache/

# IDE / OS specific files
.vscode/
.idea/
.DS_Store
Thumbs.db